{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "混合体能完赛裁决领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ENTRY_CONFIRMED",
        "SPLIT_RECORDED",
        "ANOMALY_FLAGGED",
        "RULING_SIGNED",
        "RESULT_REPUBLISHED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "race_format",
        "competition_entry",
        "split_evidence",
        "result_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
